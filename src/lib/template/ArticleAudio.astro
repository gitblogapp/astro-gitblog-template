---
import { audioCopy } from './audio-copy';
interface Props {
  src: string;
  locale?: string;
}
const { src, locale = 'en' } = Astro.props;
const copy = audioCopy(locale);
---

<section
  class="article-audio"
  data-article-audio
  data-locale={locale}
  data-pagefind-ignore
  aria-label={copy.title}
>
  <span class="sr-only">{copy.eyebrow}</span>
  <audio src={src} preload="none" controls aria-label={copy.title}></audio>
  <div class="audio-controls" hidden>
    <button class="audio-play" type="button" aria-label={copy.play} aria-busy="false">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path data-play-icon d="m9 5 11 7-11 7Z" />
        <path data-pause-icon d="M8 5v14M16 5v14" data-hidden />
      </svg>
    </button>
    <div class="audio-timeline">
      <input
        type="range"
        min="0"
        max="1"
        step="0.1"
        value="0"
        disabled
        aria-label={copy.position}
        aria-valuetext="0:00 / –:––"
        style="--progress:0%"
      />
      <div class="audio-time" aria-hidden="true">
        <span data-elapsed>0:00</span>
        <span data-duration>–:––</span>
      </div>
    </div>
    <div class="audio-speed">
      <button
        class="speed-trigger"
        type="button"
        aria-label={`${copy.speed}: 1×`}
        aria-haspopup="menu"
        aria-expanded="false"
      >
        <span data-speed-label>1×</span>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="m4 6 4 4 4-4" />
        </svg>
      </button>
      <div class="speed-menu" role="menu" tabindex="-1" aria-label={copy.speed} hidden>
        {[0.75, 1, 1.25, 1.5, 2].map((rate) => (
          <button
            type="button"
            role="menuitemradio"
            aria-checked={rate === 1}
            tabindex={rate === 1 ? 0 : -1}
            data-rate={rate}
          >
            <span>{rate}×</span>
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="m3 8 3 3 7-7" />
            </svg>
          </button>
        ))}
      </div>
    </div>
  </div>
  <span class="audio-feedback sr-only" role="status"></span>
</section>
<script>
  import { mountArticleAudio } from './article-audio';
  document.querySelectorAll<HTMLElement>('[data-article-audio]').forEach(mountArticleAudio);
</script>
<style>
  .article-audio {
    margin: 0 0 1.5rem;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
  }
  [hidden], [data-hidden] {
    display: none !important;
  }
  audio {
    display: block;
    width: 100%;
    height: 34px;
  }
  .audio-controls {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .audio-play {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--green);
    color: var(--bg);
    cursor: pointer;
  }
  .audio-play:hover {
    opacity: 0.85;
  }
  .audio-play svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }
  [data-pause-icon] {
    fill: none;
    stroke: currentColor;
    stroke-width: 4;
  }
  .audio-timeline {
    flex: 1;
    min-width: 0;
  }
  input {
    display: block;
    width: 100%;
    height: 24px;
    padding: 0;
    margin: 0;
    appearance: none;
    cursor: pointer;
    background: transparent;
  }
  input::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(
      to right,
      var(--green) var(--progress),
      var(--line) var(--progress)
    );
  }
  input::-moz-range-track {
    height: 3px;
    border-radius: 3px;
    background: var(--line);
  }
  input::-moz-range-progress {
    height: 3px;
    background: var(--green);
  }
  input::-webkit-slider-thumb {
    appearance: none;
    height: 10px;
    width: 10px;
    margin-top: -3.5px;
    border: 0;
    border-radius: 50%;
    background: var(--green);
  }
  input::-moz-range-thumb {
    height: 10px;
    width: 10px;
    border: 0;
    border-radius: 50%;
    background: var(--green);
  }
  input:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .audio-time {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.625rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .audio-speed {
    position: relative;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
  .audio-speed button {
    font: inherit;
    font-size: 0.75rem;
    color: var(--ink);
    cursor: pointer;
  }
  .speed-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-width: 78px;
    height: 34px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
  }
  .speed-trigger:hover,
  .speed-trigger[aria-expanded='true'] {
    background: var(--surface);
  }
  .audio-speed svg {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .speed-trigger svg {
    color: var(--muted);
  }
  .speed-trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
  .speed-menu {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    inset-inline-end: 0;
    min-width: 112px;
    padding: 4px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }
  .speed-menu button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    min-height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    text-align: start;
  }
  .speed-menu button:hover,
  .speed-menu button:focus-visible {
    background: var(--green-soft);
  }
  .speed-menu button[aria-checked='true'] {
    font-weight: 600;
  }
  .speed-menu svg {
    visibility: hidden;
  }
  .speed-menu button[aria-checked='true'] svg {
    visibility: visible;
  }
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }
  .speed-menu button:focus-visible {
    outline-offset: -2px;
  }
  .audio-feedback:not(.sr-only) {
    display: block;
    margin-top: 0.75rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .article-audio {
      padding: 8px 10px;
    }
    .audio-controls {
      gap: 10px;
    }
  }
</style>
