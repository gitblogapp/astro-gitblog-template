---
interface Props {
  large?: boolean;
}
const { large = false } = Astro.props;
---

<svg
  class:list={['brand-mark', { large }]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="7" fill="currentColor" />
  <path
    d="M8 23V9l8 8 8-8v14M8 9v14m16-14v14"
    stroke="var(--brand-symbol,#fff)"
    stroke-width="3"
    stroke-linejoin="round"
  />
</svg>
