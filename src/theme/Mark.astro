---
interface Props {
  large?: boolean;
}
const { large = false } = Astro.props;
---

<svg
  class:list={['brand-mark', { large }]}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="7" fill="currentColor" />
  <path
    d="M16 10c-3-2-6-2-9-2v14c3 0 6 0 9 2 3-2 6-2 9-2V8c-3 0-6 0-9 2Zm0 0v14"
    stroke="var(--brand-symbol,#fff)"
    stroke-width="2"
    stroke-linejoin="round"
  />
</svg>
