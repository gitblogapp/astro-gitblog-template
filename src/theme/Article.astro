---
import type { Blog, Post } from '../lib/template/content';
import { localizedSite } from '../lib/template/config';
import { homePath, postPath, searchPath, withBase } from '../lib/template/urls';
import { copy } from './copy';
import PostIntegrations from '../lib/template/PostIntegrations.astro';
import ArticleAudio from '../lib/template/ArticleAudio.astro';
import Slot from '../extensions/Slot.astro';
import Icon from './Icon.astro';
interface Props {
  blog: Blog;
  locale: string;
  post: Post;
}
const { blog, locale, post } = Astro.props;
const { config } = blog;
const site = localizedSite(config, locale);
const ui = copy(locale);
const context = { site, locale, pathname: postPath(config, locale, post.slug), post };
const date = (value: string) =>
  new Intl.DateTimeFormat(site.language, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(value));
const giscus =
  site.giscusEnabled &&
  site.giscusRepo &&
  site.giscusRepoId &&
  site.giscusCategory &&
  site.giscusCategoryId;
---

<div class="article-top">
  <a class="back-link" href={homePath(config, locale)}>
    <Icon name="back" /> {ui.back}
  </a>
  <span class="eyebrow">ENGINEERING / {post.category}</span>
</div>
<article class="article" data-pagefind-body data-pagefind-filter={`locale:${locale}`}>
  <header class="article-header">
    <div class="post-meta">
      <a
        class="category"
        href={`${searchPath(config, locale)}?category=${encodeURIComponent(post.category)}`}
      >
        {post.category}
      </a>
      <time datetime={post.date}>{date(post.date)}</time>
      <span>
        {post.readingMinutes} {ui.minute}
      </span>
    </div>
    <h1 id="post-title" data-pagefind-meta="title">
      {post.title}
    </h1>
    <p class="article-description" data-pagefind-meta="description">
      {post.description}
    </p>
    <span class="sr-only" data-pagefind-meta="date">
      {post.date}
    </span>
    <span class="sr-only" data-pagefind-meta="category" data-pagefind-filter="category">
      {post.category}
    </span>
    <span class="sr-only">{post.taxonomy?.tags.flatMap((tag) => tag.aliases).join(' ')}</span>
    <div class="author-line">
      <span class="author-avatar">{site.author.slice(0, 1)}</span>
      {site.authorUrl ? <a href={site.authorUrl} rel="author">{site.author}</a> : <span>{site.author}</span>}
      {post.updated && (
        <span class="updated">
          {ui.updated} {date(post.updated)}
        </span>
      )}
    </div>
  </header>
  {post.cover && (
    <img
      class="article-cover"
      src={withBase(config, post.cover)}
      alt=""
      width="1200"
      height="650"
      fetchpriority="high"
    />
  )}
  <div class="article-grid">
    <div class="article-main">
      <Slot name="article-before-body" {...context} />
      {post.audioUrl && <ArticleAudio src={post.audioUrl} {locale} />}
      <div
        class="prose article-content"
        set:html={
          post.html ||
          (post.access === 'membership'
            ? '<p>Members-only article. Sign in to read the full article.</p>'
            : '')
        }
      />
      <PostIntegrations {blog} {post} />
      <Slot name="article-after-body" {...context} />
      {config.policy.markdown && (
        <p class="post-meta" data-pagefind-ignore>
          <a href={`${postPath(config, locale, post.slug)}index.md`}>Markdown</a>
        </p>
      )}
      <div class="article-tags tags" data-pagefind-ignore>
        {post.tags.map((tag) => (
          <a
            data-pagefind-filter={`tag:${tag}`}
            href={`${searchPath(config, locale)}?q=${encodeURIComponent(tag)}`}
          >
            #{tag}
          </a>
        ))}
      </div>
      {giscus && (
        <section class="comments" data-pagefind-ignore>
          <p class="eyebrow">CONVERSATION</p>
          <h2>{ui.comments}</h2>
          <div
            class="giscus"
            data-repo={site.giscusRepo}
            data-repo-id={site.giscusRepoId}
            data-category={site.giscusCategory}
            data-category-id={site.giscusCategoryId}
            data-term={post.giscusTerm}
            data-lang={locale.split('-')[0]}
          ></div>
        </section>
      )}
      <a class="article-back" href={homePath(config, locale)}>
        <Icon name="back" /> {ui.back}
      </a>
    </div>
    {post.toc.length > 0 && (
      <aside class="toc" data-pagefind-ignore>
        <nav aria-label={ui.toc}>
          <p class="eyebrow">{ui.toc}</p>
          <ol>
            {post.toc.map((heading) => (
              <li class:list={{ nested: heading.level === 3 }}>
                <a href={`#${heading.id}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
          <a class="toc-top" href="#post-title">
            <Icon name="up" /> TOP
          </a>
        </nav>
      </aside>
    )}
  </div>
</article>
<script>
  const container = document.querySelector<HTMLElement>('.giscus');
  if (container) {
    const script = document.createElement('script');
    script.src = `${document.body.dataset.giscusHost || 'https://giscus.app'}/client.js`;
    script.async = true;
    script.crossOrigin = 'anonymous';
    for (const [key, value] of Object.entries(container.dataset))
      script.setAttribute(
        `data-${key.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`)}`,
        value!,
      );
    const options = {
      mapping: 'specific',
      strict: '0',
      'reactions-enabled': '1',
      'emit-metadata': '0',
      'input-position': 'top',
      loading: 'lazy',
      theme: document.documentElement.dataset.theme === 'dark' ? 'dark_dimmed' : 'light',
    };
    for (const [key, value] of Object.entries(options)) script.setAttribute(`data-${key}`, value);
    container.append(script);
  }
</script>
