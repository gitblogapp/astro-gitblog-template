{
  "name": "astro-gitblog-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run author:check && npm run build:site && npm run images:optimize && node scripts/build-cname.mjs && npm run hub:validate && npm run discovery:check && npm run search:index",
    "preview": "node ./scripts/preview.mjs",
    "check": "npm run author:check && npm run posts:ids:check && npm run taxonomy:check && npm run check:site",
    "posts:ids:check": "node ./scripts/post-ids.mjs --check",
    "posts:new": "tsx scripts/new-post.ts",
    "update:check": "node ./scripts/validate-update.mjs",
    "posts:ids": "node ./scripts/post-ids.mjs --write",
    "hub:validate": "node ./scripts/validate-hub-contract.mjs",
    "translate:content": "node ./scripts/sync-content.mjs",
    "content:prepare": "node ./scripts/sync-content.mjs --prepare",
    "author:context": "node ./scripts/authoring.mjs context",
    "author:new": "node ./scripts/authoring.mjs new",
    "author:status": "node ./scripts/authoring.mjs status",
    "author:translation": "node ./scripts/authoring.mjs translation",
    "author:check": "node ./scripts/authoring.mjs check",
    "author:verify": "node ./scripts/authoring.mjs verify",
    "author:deploy": "node ./scripts/authoring.mjs deploy",
    "author:deploy-status": "node ./scripts/authoring.mjs deploy-status",
    "translate:posts": "npm run translate:content",
    "site:setup": "node ./scripts/setup.mjs inspect",
    "site:configure": "node ./scripts/setup.mjs apply",
    "site:check": "node ./scripts/setup.mjs check",
    "site:pages": "node ./scripts/setup.mjs pages",
    "site:pages:status": "node ./scripts/setup.mjs pages-status",
    "discovery:check": "node ./scripts/audit-discovery.mjs",
    "taxonomy:sync": "node ./scripts/taxonomy.mjs",
    "taxonomy:check": "node ./scripts/taxonomy.mjs --check",
    "site:app:status": "node ./scripts/setup.mjs app-status",
    "build:site": "astro build",
    "check:site": "astro check",
    "search:index": "node scripts/build-search.mjs",
    "images:optimize": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@gitblogapp/browser": "file:vendor/gitblog-packages/gitblogapp-browser-0.2.0.tgz",
    "@gitblogapp/cli": "file:vendor/gitblog-packages/gitblogapp-cli-0.2.0.tgz",
    "@gitblogapp/core": "file:vendor/gitblog-packages/gitblogapp-core-0.2.0.tgz",
    "astro": "^7.3.5",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "js-yaml": "4.1.1",
    "marked": "^18.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "pagefind": "^1.5.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
